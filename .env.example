# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HolaBusiness Environment Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 1. Environment Name
# Options: 'development' | 'staging' | 'production'
NEXT_PUBLIC_APP_ENV="development"

# 2. Turso (LibSQL) Database Configuration
# Local Development: 
#   TURSO_DATABASE_URL="libsql://holabusiness-dev-[username].turso.io"
# Staging (Vercel Preview): 
#   TURSO_DATABASE_URL="libsql://holabusiness-staging-[username].turso.io"
# Live Production (Vercel Production): 
#   TURSO_DATABASE_URL="libsql://holabusiness-prod-[username].turso.io"
TURSO_DATABASE_URL="libsql://holabusiness-dev-yourname.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 3. Vault Encryption Secret (32-character string for AES-256)
VAULT_ENCRYPTION_KEY="replace_with_32_character_hex_secret_key"
